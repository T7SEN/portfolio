# Names only. Values go in .env.local (development) and in the Vercel
# environment settings; they are never committed or printed.
# Development uses Cloudflare's published Turnstile test keys. The PostHog
# names stay unset outside Production, so development sends nothing.

# Server only
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Browser
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
