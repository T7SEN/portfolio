{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "node -v && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:gpu": "playwright test --config playwright.gpu.config.ts",
    "budget": "node scripts/check-budgets.mjs",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "cmdk": "1.1.1",
    "geist": "1.9.2",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "next": "16.4.5",
    "posthog-js": "1.447.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
